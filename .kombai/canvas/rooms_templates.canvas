      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@500;600;700&display=swap');\n  :root{\n    --w-shop: oklch(90% 0.0218 31.8);   --d-shop: oklch(62% 0.11 31.8);\n    --w-double: oklch(79.8% 0.0579 311); --d-double: oklch(45% 0.12 311);\n    --w-studio: oklch(82.9% 0.034 215.6); --d-studio: oklch(44% 0.07 215.6);\n    --w-cube: oklch(60.3% 0.1213 47.2);  --d-cube: oklch(28% 0.09 47.2);\n  }\n  body{font-family:'Inter',system-ui,sans-serif;background:#f8fafc;}\n  .font-alt{font-family:'IBM Plex Sans',system-ui,sans-serif;}\n  .wash-shop{background:var(--w-shop);} .wash-double{background:var(--w-double);}\n  .wash-studio{background:var(--w-studio);} .wash-cube{background:var(--w-cube);}\n</style>\n<header class=\"border-b border-slate-200 bg-white\" data-kid=\"1\">\n<div class=\"mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-3\" data-kid=\"1-1\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1\">\n<span class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-slate-900 font-alt text-sm font-bold text-white\" data-kid=\"1-1-1-1\">U</span>\n<span class=\"text-[15px] font-extrabold tracking-tight text-slate-900\" data-kid=\"1-1-1-2\">Urbahan</span>\n<span class=\"rounded-full border border-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-600\" data-kid=\"1-1-1-3\">Admin</span>\n</div>\n<nav class=\"flex items-center gap-2 text-sm font-semibold\" data-kid=\"1-1-2\">\n<a class=\"inline-flex min-h-9 items-center rounded-xl border border-slate-200 bg-white px-3 text-slate-700\" data-kid=\"1-1-2-1\" href=\"#\">Payments</a>\n<a class=\"inline-flex min-h-9 items-center rounded-xl border border-slate-200 bg-white px-3 text-slate-700\" data-kid=\"1-1-2-2\" href=\"#\">Dashboard</a>\n<a class=\"inline-flex min-h-9 items-center rounded-xl border border-slate-200 bg-white px-3 text-slate-700\" data-kid=\"1-1-2-3\" href=\"#\">Tenants</a>\n<a aria-current=\"page\" class=\"inline-flex min-h-9 items-center rounded-xl border border-slate-900 bg-slate-900 px-3 text-white\" data-kid=\"1-1-2-4\" href=\"#\">Rooms</a>\n<a class=\"inline-flex min-h-9 items-center rounded-xl border border-slate-200 bg-white px-3 text-slate-700\" data-kid=\"1-1-2-5\" href=\"#\">More</a>\n<a class=\"inline-flex min-h-9 items-center rounded-xl border border-slate-200 bg-white px-3 text-slate-700\" data-kid=\"1-1-2-6\" href=\"#\">Logout</a>\n</nav>\n</div>\n</header>\n<main class=\"mx-auto max-w-7xl px-6 py-6\" data-kid=\"2\">\n<div class=\"flex flex-col gap-4 pb-5 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"2-1\">\n<h1 class=\"font-alt text-2xl font-bold tracking-tight text-slate-900\" data-kid=\"2-1-1\">Rooms</h1>\n<div class=\"flex items-center gap-6 text-xs font-semibold text-slate-500\" data-kid=\"2-1-2\">\n<span data-kid=\"2-1-2-1\"><span class=\"font-alt text-base font-bold tabular-nums text-slate-900\" data-kid=\"2-1-2-1-1\">29</span> rooms</span>\n<span data-kid=\"2-1-2-2\"><span class=\"font-alt text-base font-bold tabular-nums text-slate-900\" data-kid=\"2-1-2-2-1\">16</span> occupied</span>\n<span data-kid=\"2-1-2-3\"><span class=\"font-alt text-base font-bold tabular-nums text-slate-900\" data-kid=\"2-1-2-3-1\">13</span> free</span>\n</div>\n</div>\n<section aria-labelledby=\"templates-title\" data-kid=\"2-2\">\n<div class=\"flex items-end justify-between gap-3\" data-kid=\"2-2-1\">\n<h2 class=\"font-alt text-lg font-bold text-slate-900\" data-kid=\"2-2-1-1\" id=\"templates-title\">Room type templates</h2>\n<span class=\"text-xs font-semibold text-slate-500\" data-kid=\"2-2-1-2\">4 types</span>\n</div>\n<div class=\"mt-3 grid grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-slate-200\" data-kid=\"2-2-2\">\n<div class=\"wash-shop p-4\" data-kid=\"2-2-2-1\">\n<div class=\"text-xs font-semibold text-slate-900/70\" data-kid=\"2-2-2-1-1\">shop</div>\n<div class=\"mt-2 font-alt text-2xl font-bold tabular-nums tracking-tight\" data-kid=\"2-2-2-1-2\" style=\"color:var(--d-shop)\">UGX 350,000</div>\n<div class=\"mt-4 flex items-center gap-3 text-[11px] font-semibold text-slate-900/60\" data-kid=\"2-2-2-1-3\">\n<span data-kid=\"2-2-2-1-3-1\">4 occupied</span><span data-kid=\"2-2-2-1-3-2\">1 free</span>\n</div>\n</div>\n<div class=\"wash-double border-t border-slate-200 p-4 sm:border-t-0\" data-kid=\"2-2-2-2\">\n<div class=\"text-xs font-semibold text-slate-900/70\" data-kid=\"2-2-2-2-1\">double room</div>\n<div class=\"mt-2 font-alt text-2xl font-bold tabular-nums tracking-tight\" data-kid=\"2-2-2-2-2\" style=\"color:var(--d-double)\">UGX 700,000</div>\n<div class=\"mt-4 flex items-center gap-3 text-[11px] font-semibold text-slate-900/60\" data-kid=\"2-2-2-2-3\">\n<span data-kid=\"2-2-2-2-3-1\">8 occupied</span><span data-kid=\"2-2-2-2-3-2\">2 free</span>\n</div>\n</div>\n<div class=\"wash-studio border-t border-slate-200 p-4 lg:border-t-0\" data-kid=\"2-2-2-3\">\n<div class=\"text-xs font-semibold text-slate-900/70\" data-kid=\"2-2-2-3-1\">Studio</div>\n<div class=\"mt-2 font-alt text-2xl font-bold tabular-nums tracking-tight\" data-kid=\"2-2-2-3-2\" style=\"color:var(--d-studio)\">UGX 660,000</div>\n<div class=\"mt-4 flex items-center gap-3 text-[11px] font-semibold text-slate-900/60\" data-kid=\"2-2-2-3-3\">\n<span data-kid=\"2-2-2-3-3-1\">4 occupied</span><span data-kid=\"2-2-2-3-3-2\">5 free</span>\n</div>\n</div>\n<div class=\"wash-cube border-t border-slate-200 p-4 sm:border-t-0\" data-kid=\"2-2-2-4\">\n<div class=\"text-xs font-semibold text-slate-900/70\" data-kid=\"2-2-2-4-1\">Cube</div>\n<div class=\"mt-2 font-alt text-2xl font-bold tabular-nums tracking-tight\" data-kid=\"2-2-2-4-2\" style=\"color:var(--d-cube)\">UGX 250,000</div>\n<div class=\"mt-4 flex items-center gap-3 text-[11px] font-semibold text-slate-900/60\" data-kid=\"2-2-2-4-3\">\n<span data-kid=\"2-2-2-4-3-1\">0 occupied</span><span data-kid=\"2-2-2-4-3-2\">5 free</span>\n</div>\n</div>\n</div>\n</section>\n<section aria-label=\"Room management actions\" class=\"mt-3\" data-kid=\"2-3\">\n<div class=\"flex w-fit items-center gap-1 rounded-xl border border-slate-200 bg-white p-1\" data-kid=\"2-3-1\">\n<button class=\"inline-flex h-9 items-center rounded-lg bg-slate-900 px-3 text-sm font-semibold text-white\" data-kid=\"2-3-1-1\">Bulk rent</button>\n<button class=\"inline-flex h-9 items-center rounded-lg px-3 text-sm font-semibold text-slate-600\" data-kid=\"2-3-1-2\">New type</button>\n<button class=\"inline-flex h-9 items-center rounded-lg px-3 text-sm font-semibold text-slate-600\" data-kid=\"2-3-1-3\">New rooms</button>\n</div>\n<div class=\"mt-2 grid grid-cols-1 items-end gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_1fr_auto]\" data-kid=\"2-3-2\">\n<div data-kid=\"2-3-2-1\">\n<label class=\"block text-xs font-semibold text-slate-600\" data-kid=\"2-3-2-1-1\">Room type</label>\n<select class=\"mt-1 h-9 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-800\" data-kid=\"2-3-2-1-2\">\n<option data-kid=\"2-3-2-1-2-1\">double room</option>\n</select>\n</div>\n<div data-kid=\"2-3-2-2\">\n<label class=\"block text-xs font-semibold text-slate-600\" data-kid=\"2-3-2-2-1\">New monthly rent (UGX)</label>\n<input class=\"mt-1 h-9 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm tabular-nums text-slate-800\" data-kid=\"2-3-2-2-2\" value=\"700,000\"/>\n</div>\n<button class=\"h-9 rounded-xl bg-slate-900 px-4 text-sm font-semibold text-white\" data-kid=\"2-3-2-3\">Update rent</button>\n</div>\n</section>\n<section aria-labelledby=\"rooms-title\" class=\"mt-3 overflow-hidden rounded-2xl border border-slate-200 bg-white\" data-kid=\"2-4\">\n<div class=\"flex items-center justify-between border-b border-slate-200 px-4 py-3\" data-kid=\"2-4-1\">\n<h2 class=\"font-alt text-lg font-bold text-slate-900\" data-kid=\"2-4-1-1\" id=\"rooms-title\">Rooms</h2>\n<span class=