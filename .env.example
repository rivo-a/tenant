# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# core/bootstrap.php loads it with Dotenv::createImmutable(BASE_PATH),
# so key names here are read by the application exactly as written.
# ---------------------------------------------------------------------------

# 64 hex characters. Signs the daily payment verification code.
# Generate: php -r "echo bin2hex(random_bytes(32));"
PAYMENT_VERIFICATION_SECRET=

# Bearer token from https://app.sms.ug (API section). Used by public/remind.php.
# Without it, rent reminders are disabled with a clear message.
SMS_UG_API_KEY=

# Public address of the application, including scheme and base path.
# Used for canonical redirects to HTTPS and for absolute links.
# Development:  https://urbahan.local/tenant-system/public
# Production:   https://tenants.<your-domain>/tenant-system/public
APP_BASE_URL=http://localhost/tenant-system/public

# Send Strict-Transport-Security once the certificate is confirmed.
# Leave false until HTTPS is proven, true in production.
HSTS_ENABLED=false
